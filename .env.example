# Copy to .env for local (non-Docker) development:  cp .env.example .env
# Every variable is validated at startup — invalid values stop the process.
#
# Docker: docker-compose.yml sets every variable explicitly for the containers and does
# NOT read this file. Inside Docker the values differ only in networking:
#   NODE_ENV=production   REDIS_HOST=redis   TEMPORAL_ADDRESS=temporal:7233
#   SUPPLIER_A_BASE_URL=http://api:4000/supplierA   SUPPLIER_B_BASE_URL=http://api:4000/supplierB
#   TEMPORAL_WORKFLOW_BUNDLE_PATH=/app/dist/workflow-bundle.js   (set in the Dockerfile)
# No secrets are needed by default. If Redis requires a password, provide REDIS_PASSWORD
# through your deployment's secret mechanism — never commit it.

# --- Application ---
NODE_ENV=development            # development | test | production
PORT=4000
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=               # optional; set only if your Redis requires auth

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers
# TEMPORAL_WORKFLOW_BUNDLE_PATH=   # optional pre-built bundle (npm run build && npm run bundle:workflows)

# --- Mock suppliers (served by this API; called over HTTP by the worker) ---
SUPPLIER_A_BASE_URL=http://localhost:4000/supplierA
SUPPLIER_B_BASE_URL=http://localhost:4000/supplierB
SUPPLIER_A_ENABLED=true         # false => Supplier A responds 503 (simulated outage)
SUPPLIER_B_ENABLED=true
SUPPLIER_LATENCY_MS=0           # artificial delay per supplier call, to observe parallelism
SUPPLIER_REQUEST_TIMEOUT_MS=3000 # worker-side HTTP timeout per supplier call (max 4500)

# Dev-only runtime toggle endpoint for supplier outages.
# Startup is refused if this is true while NODE_ENV=production.
ENABLE_FAILURE_SIMULATION=false

# --- Cache ---
CACHE_TTL_SECONDS=300           # TTL for a full (both suppliers) aggregation
DEGRADED_CACHE_TTL_SECONDS=30   # TTL when only one supplier responded
